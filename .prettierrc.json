{
	"$schema": "https://json.schemastore.org/prettierrc.json",
	"singleQuote": false,
	"printWidth": 120,
	"trailingComma": "all",
	"tabWidth": 4,
	"useTabs": true,
	"semi": true,
	"endOfLine": "lf",
	"arrowParens": "avoid",
	"quoteProps": "consistent",
	"bracketSpacing": true,
	"bracketSameLine": true,
	"plugins": ["prettier-plugin-kotlin"]
}
